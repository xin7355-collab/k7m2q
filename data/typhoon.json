07.5毫米，苗栗縣拉庫斯478.5毫米，新北市熊空山474毫米，臺中市南湖圈谷425.5毫米，嘉義縣獨立山319.5毫米，雲林縣草嶺(2)317毫米，南投縣臺大溪頭306.5毫米，花蓮縣和平林道278.5毫米，臺南市大棟山243毫米；出現較大陣風區域如下：蘭嶼15級，彭佳嶼、基隆14級，蘇澳13級，宜蘭、花蓮、東吉島12級，成功11級，新屋、澎湖10級。＊此為第29號颱風最後一次報告。"}],"typhoon-info":[{"section":[{"title":"警報報數","value":"24"},{"title":"警報類別","value":"END"},{"title":"颱風編號","value":"29"},{"title":"颱風資訊","analysis":{"time":"2026-10-24T12:00:00+00:00","position":"27.80,123.40","gust":{"value":"33","unit":"m/s"},"pressure":{"value":"985","unit":"hPa"},"scale":[{"value":"輕度颱風","lang":"zh-TW"},{"value":"SEVERE TROPICAL STORM","lang":"en"}],"max_winds":{"value":"25","unit":"m/s"},"radius_of_15mps":{"value":"200","unit":"km"}},"prediction":{"time":"2026-10-25T12:00:00+00:00","position":"31.00,126.20","gust":{"value":"25","unit":"m/s"},"pressure":{"value":"998","unit":"hPa"},"max_winds":{"value":"18","unit":"m/s"},"radius_of_15mps":{"value":"120","unit":"km"}},"typhoon_name":"CHAMPI","cwa_typhoon_name":"薔琵"}]}]},"web":"https://www.cwa.gov.tw/V8/C/P/Warning/FIFOWS.html","parameter":[{"valueName":"alert_title","value":"解除颱風警報"}],"area":[{"areaDesc":"基隆市","geocode":{"valueName":"Taiwan_Geocode_112","value":"10017000"}},{"areaDesc":"臺北市","geocode":{"valueName":"Taiwan_Geocode_112","value":"63000000"}},{"areaDesc":"新北市","geocode":{"valueName":"Taiwan_Geocode_112","value":"65000000"}},{"areaDesc":"宜蘭縣","geocode":{"valueName":"Taiwan_Geocode_112","value":"10002000"}},{"areaDesc":"桃園市","geocode":{"valueName":"Taiwan_Geocode_112","value":"68000000"}},{"areaDesc":"新竹縣","geocode":{"valueName":"Taiwan_Geocode_112","value":"10004000"}},{"areaDesc":"新竹市","geocode":{"valueName":"Taiwan_Geocode_112","value":"10018000"}},{"areaDesc":"花蓮縣","geocode":{"valueName":"Taiwan_Geocode_112","value":"10015000"}},{"areaDesc":"苗栗縣","geocode":{"valueName":"Taiwan_Geocode_112","value":"10005000"}},{"areaDesc":"臺中市","geocode":{"valueName":"Taiwan_Geocode_112","value":"66000000"}},{"areaDesc":"彰化縣","geocode":{"valueName":"Taiwan_Geocode_112","value":"10007000"}},{"areaDesc":"南投